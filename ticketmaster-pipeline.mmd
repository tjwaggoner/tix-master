flowchart LR
    %% External Source
    TM[Ticketmaster API<br/>External Source]:::external

    %% Ingestion Layer
    INGEST[Python Ingestion<br/>Daily @ 2 AM<br/>JSON Output]:::ingestion
    VOL[Unity Catalog Volume<br/>/Volumes/ticket_master/bronze/raw_data]:::volume

    %% Bronze Layer - Auto Loader Streaming
    AL[Auto Loader<br/>cloudFiles Streaming]:::streaming
    BR_EVENTS[events_raw]:::bronze
    BR_VENUES[venues_raw]:::bronze
    BR_ATTR[attractions_raw]:::bronze
    BR_CLASS[classifications_raw]:::bronze

    %% Silver Layer - Streaming Transformations
    STREAM[Structured Streaming<br/>foreachBatch MERGE<br/>Clean + Dedupe + Surrogate Keys]:::streaming
    SV_EVENTS[events]:::silver
    SV_VENUES[venues<br/>markets as Variant]:::silver
    SV_ATTR[attractions]:::silver
    SV_CLASS[classifications]:::silver
    SV_EV[event_venues<br/>bridge table]:::silver
    SV_EA[event_attractions<br/>bridge table]:::silver

    %% Gold Layer - Batch SQL
    BATCH[Batch SQL<br/>Transformations]:::batch
    DIM_DATE[dim_date<br/>Standard Dimension]:::gold_dim
    DIM_VENUE[dim_venue<br/>SCD Type 2]:::gold_dim
    DIM_ATTR[dim_attraction<br/>SCD Type 2]:::gold_dim
    DIM_CLASS[dim_classification<br/>SCD Type 2]:::gold_dim
    FACT[fact_events]:::gold_fact
    MV1[mv_events_by_date_venue]:::gold_mv
    MV2[mv_events_by_attraction]:::gold_mv
    MV3[mv_monthly_summary]:::gold_mv

    %% Consumption Layer
    GENIE[AI/BI Genie]:::consumer
    BI[BI Tools]:::consumer
    SQL[SQL Warehouse]:::consumer

    %% Flow: Source to Ingestion
    TM --> INGEST --> VOL

    %% Flow: Bronze Layer
    VOL --> AL
    AL --> BR_EVENTS
    AL --> BR_VENUES
    AL --> BR_ATTR
    AL --> BR_CLASS

    %% Flow: Silver Layer
    BR_EVENTS --> STREAM
    BR_VENUES --> STREAM
    BR_ATTR --> STREAM
    BR_CLASS --> STREAM

    STREAM --> SV_EVENTS
    STREAM --> SV_VENUES
    STREAM --> SV_ATTR
    STREAM --> SV_CLASS
    STREAM --> SV_EV
    STREAM --> SV_EA

    %% Flow: Gold Layer
    SV_EVENTS --> BATCH
    SV_VENUES --> BATCH
    SV_ATTR --> BATCH
    SV_CLASS --> BATCH
    SV_EV --> BATCH
    SV_EA --> BATCH

    BATCH --> DIM_DATE
    BATCH --> DIM_VENUE
    BATCH --> DIM_ATTR
    BATCH --> DIM_CLASS
    BATCH --> FACT
    BATCH --> MV1
    BATCH --> MV2
    BATCH --> MV3

    %% Flow: Consumption
    DIM_DATE --> GENIE
    DIM_VENUE --> GENIE
    DIM_ATTR --> GENIE
    DIM_CLASS --> GENIE
    FACT --> GENIE
    MV1 --> GENIE
    MV2 --> GENIE
    MV3 --> GENIE

    FACT --> BI
    MV1 --> BI
    MV2 --> BI
    MV3 --> BI

    FACT --> SQL
    DIM_DATE --> SQL
    DIM_VENUE --> SQL

    %% Styling
    classDef external fill:#ff6b6b,stroke:#c92a2a,color:#fff,stroke-width:3px
    classDef ingestion fill:#ffd43b,stroke:#fab005,color:#000,stroke-width:2px
    classDef volume fill:#ffa94d,stroke:#fd7e14,color:#000,stroke-width:2px
    classDef streaming fill:#4dabf7,stroke:#1971c2,color:#fff,stroke-width:3px,stroke-dasharray: 5 5
    classDef bronze fill:#d9bf77,stroke:#b8860b,color:#000,stroke-width:2px
    classDef silver fill:#c0c0c0,stroke:#808080,color:#000,stroke-width:2px
    classDef gold_dim fill:#ffd700,stroke:#daa520,color:#000,stroke-width:2px
    classDef gold_fact fill:#ff8c00,stroke:#cc7000,color:#fff,stroke-width:2px
    classDef gold_mv fill:#98d8c8,stroke:#20c997,color:#000,stroke-width:2px,stroke-dasharray: 3 3
    classDef batch fill:#748ffc,stroke:#5c7cfa,color:#fff,stroke-width:2px
    classDef consumer fill:#69db7c,stroke:#37b24d,color:#000,stroke-width:3px
